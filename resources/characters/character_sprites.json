{
  // Character sprite sheets per visual archetype. Server monster/player definitions carry the archetype key.
  // Sheets are third-party art imported locally by tools/assets/import-assets.sh into resources/thirdparty/
  // (git-ignored); when a sheet is missing the client draws a procedural token instead.
  //
  // Per archetype: frame cell size, pivot = ground contact point (bottom-centre of the feet) inside a frame,
  // bodyHeight = feet-to-head pixels (drives water submersion), heightTiles = on-screen body height in tiles.
  // Sheets are horizontal strips facing right. Clip keys: idle, walk, attack_melee, attack_ranged, cast, hurt,
  // death. Missing clips fall back: attack_ranged/cast -> attack_melee -> idle; walk/hurt -> idle.
  // frames: 0 = every cell of the sheet. loop: defaults to true for idle/walk, false otherwise.
  "version": 1,
  "sheetRoot": "../thirdparty",
  "archetypes": [
    {
      "key": "human_soldier",
