<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Carbon.Desktop</RootNamespace>
        <AssemblyName>Carbon.Desktop</AssemblyName>
        <NoWarn>$(NoWarn);CA1303</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Carbon.Desktop.Abstractions\Carbon.Desktop.Abstractions.csproj" />
        <ProjectReference Include="..\Carbon.Desktop.Networking\Carbon.Desktop.Networking.csproj" />
        <ProjectReference Include="..\Carbon.Desktop.Rendering\Carbon.Desktop.Rendering.csproj" />
        <ProjectReference Include="..\..\graphics\Carbon.Graphics.Batching\Carbon.Graphics.Batching.csproj" />
        <ProjectReference Include="..\..\graphics\Carbon.Graphics.Fonts\Carbon.Graphics.Fonts.csproj" />
        <ProjectReference Include="..\..\graphics\Carbon.Graphics.OpenGL\Carbon.Graphics.OpenGL.csproj" />
        <ProjectReference Include="..\..\graphics\Carbon.Graphics.Scenes\Carbon.Graphics.Scenes.csproj" />
        <ProjectReference Include="..\..\graphics\Carbon.Graphics.UI\Carbon.Graphics.UI.csproj" />
        <ProjectReference Include="..\..\graphics\Carbon.Graphics.Windowing\Carbon.Graphics.Windowing.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\resources\art\**\*" Link="resources\art\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\resources\fonts\**\*" Link="resources\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\resources\ui\**\*" Link="resources\ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\..\resources\localization\**\*.json" Link="resources\localization\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
