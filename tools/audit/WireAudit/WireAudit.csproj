<Project Sdk="Microsoft.NET.Sdk">
    <!-- Wire-protocol audit (docs/audit/2026-11-wire-protocol.md). Run: tools/audit/wire-audit.sh -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsAotCompatible>false</IsAotCompatible>
        <IsTrimmable>false</IsTrimmable>
        <RootNamespace>Carbon.Tools.WireAudit</RootNamespace>
        <!-- A report writer: StringBuilder.Append results are deliberately discarded. -->
        <NoWarn>$(NoWarn);IDE0058</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>
</Project>
